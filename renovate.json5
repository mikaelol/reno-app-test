{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>statnett/renovate-config',
    ':semanticCommitTypeAll(ci)',
    ':prHourlyLimitNone',
    'customManagers:dockerfileVersions',
  ],
  rebaseWhen: 'never',
  packageRules: [
    {
      matchPackageNames: [
        'ghcr.io/aquasecurity/trivy',
      ],
      semanticCommitType: 'build',
    },
    {
      matchManagers: [
        'gomod',
      ],
      semanticCommitType: 'build',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
    },
  ],
  ignorePaths: [],
}
