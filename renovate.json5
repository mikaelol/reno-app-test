{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>statnett/renovate-config"],
  rebaseWhen: "never",
  packageRules: [
    {
      matchPackageNames: ["ghcr.io/aquasecurity/trivy"],
      semanticCommitType: "build",
    },
  ],
  //ignorePaths: [],
  printConfig: true,
}
